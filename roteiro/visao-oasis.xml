<ViewerConfig>
  <QueryConfig>
    <QueryParams>
      <UserQuery />
    </QueryParams>
    <QueryNode>
      <Name>Oásis</Name>
      <Description>Serviços que caíram, pool do IIS, alertas de desempenho, vigia do Oásis e auditoria</Description>
      <QueryList>
        <Query Id="0">
          <Select Path="System">*[System[Provider[@Name='Service Control Manager'] and (EventID=7031 or EventID=7034)]]</Select>
          <Select Path="System">*[System[Provider[@Name='Microsoft-Windows-WAS'] and (Level=1 or Level=2 or Level=3)]]</Select>
          <Select Path="Application">*[System[Provider[@Name='Oasis']]]</Select>
          <Select Path="Microsoft-Windows-Diagnosis-PLA/Operational">*[System[(EventID=2031)]]</Select>
          <Select Path="Security">*[System[(EventID=4625 or EventID=4663 or EventID=4720 or EventID=4740 or EventID=4719)]]</Select>
        </Query>
      </QueryList>
    </QueryNode>
  </QueryConfig>
</ViewerConfig>
